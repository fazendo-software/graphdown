# Copie para `.env` e preencha. Usado pelo `compose.yaml`; em produção sem Docker, exporte
# essas variáveis diretamente no ambiente.

# Segredo do HMAC que protege o hash do token de sessão guardado em `sessoes.token_hash`.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Senha do Postgres do compose (usuário `grapydown`, banco `grapydown`).
POSTGRES_SENHA=grapydown

# Porta exposta pelo compose. Sem Docker, PORTA é lida direto do ambiente pelo servidor.
PORTA=5174
